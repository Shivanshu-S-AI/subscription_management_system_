# Brightloop Subscription Management System - Environment Variables

# Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Client Key (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (secret - never expose to browser)
# Required for server-side elevated administration actions and user provisioning
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
